# PostgreSQL connection string
# Local dev with docker-compose: docker compose up -d, then use the line below.
#
# NOTE: this is for the DEV database. Running `npm test` uses a *separate*
# database configured via .env.test (see .env.test.example) so the test
# suite can never pollute your seeded dev/demo data.
DATABASE_URL="postgresql://autopick:autopick@localhost:5432/autopick?schema=public"

# Secret used to sign session JWTs (company/admin auth) and CSRF-related tokens.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Base URL of the app (used for absolute links in notifications, etc.)
APP_URL="http://localhost:3000"

# How many days a client Request stays ACTIVE before it EXPIREs.
REQUEST_TTL_DAYS=7

# Minimum offer impressions a company needs before it is eligible for
# "top by conversion" leaderboards (avoids 1-impression/1-lead = 100% noise).
ANALYTICS_MIN_IMPRESSIONS_FOR_CONVERSION_RANKING=20

# File storage driver: "local" (writes to disk via UPLOADS_DIR) or "s3".
STORAGE_DRIVER="local"

# Absolute directory LocalFileStorage writes uploaded files to, and the
# /uploads/* route reads them back from. Defaults to "<repo>/public/uploads"
# when unset, which is fine for local dev.
#
# ON RAILWAY (or any host with an ephemeral container filesystem) THIS MUST
# POINT AT A MOUNTED VOLUME, e.g.:
#   UPLOADS_DIR="/data/uploads"
# with a Railway Volume attached to this service and mounted at "/data".
# Without a volume, anything written here is lost on every redeploy,
# restart, or new instance — see docs/ARCHITECTURE.md §5.
# UPLOADS_DIR="/data/uploads"

# Only used when STORAGE_DRIVER=s3
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""

# AutoPickBot: synthetic-traffic scheduler that creates 2 realistic bot
# requests per day (10:00 and 19:00, AUTOPICK_BOT_TIMEZONE) through the
# exact same production flow as a real request, tagged internally with
# source="autopick_bot", and deletes each one 24h after creation. Disabled
# by default — set to "true" to enable. See docs/AUTOPICK_BOT.md.
AUTOPICK_BOT_ENABLED=false
AUTOPICK_BOT_TIMEZONE="Asia/Almaty"
