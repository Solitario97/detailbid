# Environment for `npm test` (Vitest). Copy to .env.test.
#
# IMPORTANT: this must point at a *separate* database from your dev DB
# (DATABASE_URL in .env.example / .env). The test suite creates and deletes
# rows freely — pointing it at your dev database will pollute your seeded
# demo data (cities, companies, requests) with test fixtures.
DATABASE_URL="postgresql://autopick:autopick@localhost:5432/autopick_test?schema=public"
AUTH_SECRET="test-secret-test-secret-test-secret-test-secret"

# AutoPickBot must stay disabled for the general test suite (it defaults to
# false when unset, same as here) — tests that specifically exercise the
# bot set AUTOPICK_BOT_ENABLED=true themselves at runtime, scoped to that
# test file, rather than relying on this file.
AUTOPICK_BOT_ENABLED=false
